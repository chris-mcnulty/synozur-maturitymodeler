          "resourceLink": null,
          "resourceDescription": null,
          "isNotApplicable": false,
          "translations": {
            "es": "Uso habilidades que otras personas han publicado, pero no he creado las mías."
          }
        },
        {
          "text": "I have written a personal skill for a task I do often.",
