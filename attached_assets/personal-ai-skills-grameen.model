    {
      "dimensionKey": "getting-started",
      "text": "If you use a personal AI account that work did not give you, is it all right to put work information into it, such as a client's name or details?",
      "type": "multiple_choice",
      "order": 3,
      "minValue": null,
      "maxValue": null,
      "unit": null,
      "placeholder": null,
      "improvementStatement": null,
      "resourceTitle": null,
      "resourceLink": null,
      "resourceDescription": null,
      "translations": {
        "es": {
          "text": "Si usted usa una cuenta personal de IA que no le dio el trabajo, ¿está bien poner en ella información del trabajo, por ejemplo el nombre o los datos de una clienta?",
          "answers": {
            "1": "No. La información del trabajo solo debe ir en las herramientas que la organización ha aprobado.",
            "2": "Sí, siempre y cuando primero le quite el nombre a la clienta.",
            "3": "Sí, siempre y cuando no guarde la respuesta.",
            "4": "No estoy seguro(a)."
          }
        }
      },
      "isScored": true,
      "isOptional": false,
      "answers": [
        {
          "text": "No. Work information should only go into tools the organization has approved.",
          "score": 100,
          "order": 1,
          "typeKey": null,
          "improvementStatement": null,
          "resourceTitle": null,
          "resourceLink": null,
          "resourceDescription": null,
          "isNotApplicable": false,
          "translations": {
            "es": "No. La información del trabajo solo debe ir en las herramientas que la organización ha aprobado."
          }
        },
        {
          "text": "Yes, as long as I take the client's name out first.",
          "score": 0,
          "order": 2,
          "typeKey": null,
          "improvementStatement": null,
          "resourceTitle": null,
          "resourceLink": null,
          "resourceDescription": null,
          "isNotApplicable": false,
          "translations": {
            "es": "Sí, siempre y cuando primero le quite el nombre a la clienta."
          }
        },
        {
          "text": "Yes, as long as I do not save the answer.",
