  "course": {
    "title": "Getting Started with Microsoft 365 Copilot",
    "slug": "getting-started-with-microsoft-365-copilot",
    "description": "A concise, practical introduction to Microsoft 365 Copilot. Learn how to use approved AI safely, write effective prompts, work with Researcher and Analyst, create focused custom agents, and apply Copilot Cowork and reusable skills.",
    "summary": "Build safe, effective Copilot habits—from a strong first prompt to specialized agents and delegated work.",
    "imageUrl": "/objects/slides/copilot-hero-ab738732-47f0-4570-86a6-d26013134082.svg",
    "estimatedMinutes": 20,
    "status": "draft",
    "visibility": "private",
    "passingScore": 67,
    "certificateEnabled": false,
    "tags": [
      "Microsoft 365 Copilot",
      "AI productivity",
      "foundations"
    ],
    "modules": [
      {
        "title": "Introduction",
        "description": "Understand what Copilot is, how generative AI works, and the guardrails that protect work data.",
        "order": 0,
        "lessons": [
          {
            "title": "Start safely with Copilot",
            "type": "slides",
            "order": 0,
            "estimatedMinutes": 3,
            "required": true,
            "content": {
              "slides": [
                {
                  "id": "slide_mt3a5k7g_jhrg8i",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_883sha",
                      "type": "heading",
                      "level": 2,
                      "text": "Your Copilot starting point"
                    },
                    {
                      "id": "b_mt3a5k7g_wevlix",
                      "type": "image",
                      "url": "/objects/slides/copilot-intro-97eba09a-434e-427a-89a2-a7afcec6e0c4.svg",
                      "alt": "Several translucent layers overlap from lower left to upper right, each evenly spaced and softly bounded, conveying structured safeguards, balance, and thoughtful depth within an abstract system."
                    },
                    {
                      "id": "b_mt3a5k7g_dcs1vc",
                      "type": "text",
                      "html": "<p>Microsoft 365 Copilot is a thinking and drafting partner grounded in the work you can already access.</p><p>Use it to move from a blank page to a useful first draft—then apply your judgment before sharing or acting.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "This opening illustration uses a compass surrounded by a purple-to-pink field to represent a guided first step. Copilot helps you find direction, but you remain responsible for the destination."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_bw9s79",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_clt6ta",
                      "type": "heading",
                      "level": 2,
                      "text": "Generative AI creates; it does not verify"
                    },
                    {
                      "id": "b_mt3a5k7g_kjdihn",
                      "type": "text",
                      "html": "<p>Generative AI predicts useful language and patterns. It can summarize, draft, compare, and brainstorm.</p><p><strong>Always review the result.</strong> Check important facts, dates, calculations, sources, and tone.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Generative AI is a capable drafting partner, not an authority. Review important claims and confirm that the output fits the purpose."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_iadt8h",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_5muurk",
                      "type": "heading",
                      "level": 2,
                      "text": "Keep work data safe"
                    },
                    {
                      "id": "b_mt3a5k7g_w2gprv",
                      "type": "text",
                      "html": "<p>Use your organization’s approved Copilot experience for work. Do not paste confidential work into consumer AI tools.</p><p>Copilot respects the permissions already applied to Microsoft 365 content; it does not grant access to information you could not otherwise open.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Three overlapping layers represent approved tools, existing access permissions, and human review. Together they form the safe boundary for using Copilot at work."
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Copilot app and prompting",
        "description": "Find the core experiences, write stronger prompts, choose work or web grounding, and reuse useful results.",
        "order": 1,
        "lessons": [
          {
            "title": "Work effectively in the Copilot app",
            "type": "slides",
            "order": 0,
            "estimatedMinutes": 5,
            "required": true,
            "content": {
              "slides": [
                {
                  "id": "slide_mt3a5k7g_ml1exd",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_g9fml7",
                      "type": "heading",
                      "level": 2,
                      "text": "One app, several ways to work"
                    },
                    {
                      "id": "b_mt3a5k7g_0t8zx8",
                      "type": "image",
                      "url": "/objects/slides/copilot-app-5dce64eb-7424-4df1-935c-4cba257d9930.svg",
                      "alt": "A single curved path begins at the lower left, bends through two subtle waypoints, and opens toward the upper right, expressing guided progress and increasingly precise direction."
                    },
                    {
                      "id": "b_mt3a5k7g_ozpu3k",
                      "type": "text",
                      "html": "<p>The Copilot app brings together chat, content creation, agents, pages, and connected Microsoft 365 apps.</p><p>Availability and labels can vary by license and administrator settings, so focus on the task rather than memorizing a screen.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "An abstract pathway branches into several connected destinations. It represents chat, creation, agents, pages, and apps without recreating a product interface."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_88mbot",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_2f6yru",
                      "type": "heading",
                      "level": 2,
                      "text": "Build prompts with G-C-S-E"
                    },
                    {
                      "id": "b_mt3a5k7g_4f4xuu",
                      "type": "text",
                      "html": "<p><strong>Goal:</strong> what you need. <strong>Context:</strong> why and for whom. <strong>Source:</strong> the files, messages, or web information to use. <strong>Expectations:</strong> format, tone, and constraints.</p><p>Example: “Draft a five-bullet briefing for the leadership team using the attached project update. Highlight decisions, risks, and owners.”</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "A strong prompt names the goal, context, source, and expectations. Specific instructions give Copilot a clearer target."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_15ufkk",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_v25vt6",
                      "type": "heading",
                      "level": 2,
                      "text": "Use two prompting habits"
                    },
                    {
                      "id": "b_mt3a5k7g_uq78dj",
                      "type": "text",
                      "html": "<p>Be specific enough to establish the first direction, then iterate: ask Copilot to shorten, compare, challenge, reformat, or explain.</p><p>Reference trusted context when available. Use the app’s file, person, email, or agent references instead of copying large amounts of content.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Start with a clear first request, then refine the result through short follow-up prompts. Reference trusted work content instead of pasting it repeatedly."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_uw8sz0",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_6e4ft8",
                      "type": "heading",
                      "level": 2,
                      "text": "Choose the right grounding"
                    },
                    {
                      "id": "b_mt3a5k7g_d0jp7z",
                      "type": "text",
                      "html": "<p>Use work grounding when the answer should reflect your organization’s files, messages, meetings, and people.</p><p>Use web grounding for current public information. Treat both as starting points and verify material decisions.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Two converging paths represent work content and public web information. The destination is a reviewed answer shaped by the learner’s judgment."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_239kx1",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_nee1qi",
                      "type": "heading",
                      "level": 2,
                      "text": "Keep and reuse useful results"
                    },
                    {
                      "id": "b_mt3a5k7g_2om160",
                      "type": "text",
                      "html": "<p>Turn longer responses into a page when you want to refine and share them. Export only when the target format helps the next step.</p><p>Conversation history can preserve continuity. Settings and custom instructions can improve consistency, subject to your organization’s policies.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Useful results move from conversation into a reusable working document, an export, or a later conversation. The learner chooses the form that supports the next action."
                  }
                }
              ]
            }
          },
          {
            "title": "Knowledge check: prompting",
            "type": "quiz",
            "order": 1,
            "estimatedMinutes": 1,
            "required": true,
            "content": {
              "passingScore": 67,
              "questions": [
                {
                  "id": "prompt-grounding",
                  "text": "Which prompt gives Copilot the clearest direction?",
                  "type": "single",
                  "options": [
                    {
                      "id": "prompt-grounding-1",
                      "text": "Tell me about this project."
                    },
                    {
                      "id": "prompt-grounding-2",
                      "text": "Write something professional."
                    },
                    {
                      "id": "prompt-grounding-3",
                      "text": "Draft a five-bullet leadership briefing from the attached update, highlighting decisions, risks, and owners."
                    }
                  ],
                  "correctIds": [
                    "prompt-grounding-3"
                  ],
                  "explanation": "The third prompt supplies a goal, audience context, source, and clear output expectations."
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Researcher and Analyst",
        "description": "Choose the right first-party agent for evidence-rich research or data analysis.",
        "order": 2,
        "lessons": [
          {
            "title": "Go deeper with first-party agents",
            "type": "slides",
            "order": 0,
            "estimatedMinutes": 3,
            "required": true,
            "content": {
              "slides": [
                {
                  "id": "slide_mt3a5k7g_4dbihp",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_2ktrpm",
                      "type": "heading",
                      "level": 2,
                      "text": "Agents specialize the work"
                    },
                    {
                      "id": "b_mt3a5k7g_l1fg2p",
                      "type": "image",
                      "url": "/objects/slides/copilot-agents-f58a0190-f5c4-4b6f-ae57-1942acdc3404.svg",
                      "alt": "A sparse constellation of points spans the upper half of the composition, with fine connecting lines clustering into two related regions, suggesting discovery, comparison, and insight across distance."
                    },
                    {
                      "id": "b_mt3a5k7g_p351dx",
                      "type": "text",
                      "html": "<p>First-party agents extend Copilot with focused reasoning patterns and tools. Researcher supports evidence-rich inquiry; Analyst supports structured data exploration.</p><p>Start with a clear question, provide the right sources, and review the result before using it.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "A constellation connects two larger nodes to a shared center. The nodes represent specialized research and analysis capabilities working from trusted context."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_92jbdz",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_r32zcg",
                      "type": "heading",
                      "level": 2,
                      "text": "Use Researcher for a sourced brief"
                    },
                    {
                      "id": "b_mt3a5k7g_irsjmo",
                      "type": "text",
                      "html": "<p>Ask Researcher to investigate a question across permitted work content and relevant public sources, then synthesize themes and cite evidence.</p><p>Use it for market scans, issue briefs, options analysis, and topics that need depth rather than a quick answer.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Researcher follows multiple evidence paths and brings them together into a sourced brief. Check that each important conclusion is supported."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_vz23gq",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_muq9cz",
                      "type": "heading",
                      "level": 2,
                      "text": "Use Analyst to understand data"
                    },
                    {
                      "id": "b_mt3a5k7g_6zin4z",
                      "type": "text",
                      "html": "<p>Give Analyst a clear business question and a well-structured spreadsheet or CSV. Ask it to identify patterns, exceptions, comparisons, and useful visual summaries.</p><p>Confirm definitions, filters, and calculations—especially when the result will influence a decision.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Analyst organizes data into patterns and exceptions. The essential accessibility message is to confirm the inputs, definitions, filters, and calculations."
                  }
                }
              ]
            }
          },
          {
            "title": "Knowledge check: specialized agents",
            "type": "quiz",
            "order": 1,
            "estimatedMinutes": 1,
            "required": true,
            "content": {
              "passingScore": 67,
              "questions": [
                {
                  "id": "agent-choice",
                  "text": "Which agent is the better starting point for finding patterns in a structured spreadsheet?",
                  "type": "single",
                  "options": [
                    {
                      "id": "agent-choice-1",
                      "text": "Researcher"
                    },
                    {
                      "id": "agent-choice-2",
                      "text": "Analyst"
                    },
                    {
                      "id": "agent-choice-3",
                      "text": "A custom communications agent"
                    }
                  ],
                  "correctIds": [
                    "agent-choice-2"
                  ],
                  "explanation": "Analyst is designed to reason over structured data and help surface patterns, comparisons, and exceptions."
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Custom agents",
        "description": "Build a reusable specialist grounded in instructions and trusted knowledge.",
        "order": 3,
        "lessons": [
          {
            "title": "Create a focused custom agent",
            "type": "slides",
            "order": 0,
            "estimatedMinutes": 3,
            "required": true,
            "content": {
              "slides": [
                {
                  "id": "slide_mt3a5k7g_o4a4u3",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_1viuti",
                      "type": "heading",
                      "level": 2,
                      "text": "A reusable expert for a repeated job"
                    },
                    {
                      "id": "b_mt3a5k7g_xmew5j",
                      "type": "image",
                      "url": "/objects/slides/copilot-custom-e374dcf5-2a1a-4db9-8f01-d3a5ece25f70.svg",
                      "alt": "Stacked geometric blocks anchor the lower center while smaller aligned blocks extend outward in measured rows, indicating a stable foundation, controlled expansion, and dependable structure."
                    },
                    {
                      "id": "b_mt3a5k7g_tpsdz8",
                      "type": "text",
                      "html": "<p>A custom agent combines a clear purpose, durable instructions, and selected knowledge so people do not have to rebuild the same prompt every time.</p><p>Good candidates are frequent, bounded tasks with trusted source material and an identifiable owner.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Four interlocking blocks represent purpose, instructions, trusted knowledge, and ownership. Together they create a bounded reusable specialist."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_7xi6c0",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_xteaiw",
                      "type": "heading",
                      "level": 2,
                      "text": "Build in five deliberate steps"
                    },
                    {
                      "id": "b_mt3a5k7g_n86nk6",
                      "type": "text",
                      "html": "<p>1. Name the job and audience. 2. Define what success looks like. 3. Add trusted knowledge. 4. Write boundaries and response instructions. 5. Test realistic questions.</p><p>Improve the agent when it fails a test; do not hide ambiguity behind a longer description.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "The five-step sequence moves from job definition through success criteria, knowledge, boundaries, and realistic testing."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_rwhy7w",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_fggvm8",
                      "type": "heading",
                      "level": 2,
                      "text": "Ground the agent in maintained content"
                    },
                    {
                      "id": "b_mt3a5k7g_5q0r8z",
                      "type": "text",
                      "html": "<p>An agent built on policy, product, or process content is only as reliable as those sources.</p><p>Assign an owner, remove obsolete material, and retest when the underlying content or business process changes.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "A central source connects to a reusable agent and several outputs. Ownership and maintenance keep every output tied to current trusted content."
                  }
                }
              ]
            }
          },
          {
            "title": "Knowledge check: custom agents",
            "type": "quiz",
            "order": 1,
            "estimatedMinutes": 1,
            "required": true,
            "content": {
              "passingScore": 67,
              "questions": [
                {
                  "id": "agent-maintenance",
                  "text": "What makes a custom agent dependable over time?",
                  "type": "single",
                  "options": [
                    {
                      "id": "agent-maintenance-1",
                      "text": "A very long name and description"
                    },
                    {
                      "id": "agent-maintenance-2",
                      "text": "More source files, whether current or not"
                    },
                    {
                      "id": "agent-maintenance-3",
                      "text": "A clear purpose, trusted maintained knowledge, boundaries, an owner, and realistic testing"
                    }
                  ],
                  "correctIds": [
                    "agent-maintenance-3"
                  ],
                  "explanation": "Dependability comes from bounded purpose, maintained sources, clear instructions, ownership, and testing—not volume."
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Copilot Cowork and skills",
        "description": "Delegate larger outcomes and package instructions into reusable skills.",
        "order": 4,
        "lessons": [
          {
            "title": "Move from prompts to delegated work",
            "type": "slides",
            "order": 0,
            "estimatedMinutes": 3,
            "required": true,
            "content": {
              "slides": [
                {
                  "id": "slide_mt3a5k7g_7pan7y",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_uz42cd",
                      "type": "heading",
                      "level": 2,
                      "text": "Delegate a larger outcome with Cowork"
                    },
                    {
                      "id": "b_mt3a5k7g_ywz6ko",
                      "type": "image",
                      "url": "/objects/slides/copilot-cowork-6b6dcbe0-7b56-46eb-90e4-2629bdd3753c.svg",
                      "alt": "A central circle is surrounded by three evenly spaced orbital arcs, each tracing a distinct loop that returns inward, suggesting shared motion, coordination, and repeatable patterns around a common core."
                    },
                    {
                      "id": "b_mt3a5k7g_0hsw94",
                      "type": "text",
                      "html": "<p>Copilot Cowork is designed for work that needs planning and multiple coordinated steps rather than one response.</p><p>Define the desired outcome, available context, checkpoints, and boundaries. Review the plan and the resulting work before it moves forward.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "Several orbiting work elements move around a clearly bounded center. The image represents coordinated steps, checkpoints, and human oversight without showing software screens."
                  }
                },
                {
                  "id": "slide_mt3a5k7g_jdzkcv",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_3onnf5",
                      "type": "heading",
                      "level": 2,
                      "text": "Turn reliable instructions into skills"
                    },
                    {
                      "id": "b_mt3a5k7g_gxg515",
                      "type": "text",
                      "html": "<p>A skill is a reusable block of instructions for a task you expect to repeat. It can capture sequence, quality criteria, format, and guardrails.</p><p>Keep skills narrow enough to test. Update them when the process, source material, or expected output changes.</p>"
                    }
                  ],
                  "narration": {
                    "mode": "none",
                    "text": "A reusable instruction block feeds several consistent outputs. The visual emphasizes repeatability, quality criteria, and guardrails."
                  }
                }
              ]
            }
          },
          {
            "title": "Knowledge check: delegated work",
            "type": "quiz",
            "order": 1,
            "estimatedMinutes": 1,
            "required": true,
            "content": {
              "passingScore": 67,
              "questions": [
                {
                  "id": "cowork-skill",
                  "text": "When should you prefer a reusable skill over an ad hoc prompt?",
                  "type": "single",
                  "options": [
                    {
                      "id": "cowork-skill-1",
                      "text": "When a bounded task repeats and the same sequence, quality criteria, and guardrails should apply"
                    },
                    {
                      "id": "cowork-skill-2",
                      "text": "Whenever the task contains more than one sentence"
                    },
                    {
                      "id": "cowork-skill-3",
                      "text": "Only when no source material exists"
                    }
                  ],
                  "correctIds": [
                    "cowork-skill-1"
                  ],
                  "explanation": "A skill is valuable when a repeatable task benefits from consistent instructions, criteria, and boundaries."
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Recap and next steps",
        "description": "Consolidate the core habits and choose one safe, useful task to try next.",
        "order": 5,
        "lessons": [
          {
            "title": "Put Copilot to work",
            "type": "slides",
            "order": 0,
            "estimatedMinutes": 1,
            "required": true,
            "content": {
              "slides": [
                {
                  "id": "slide_mt3a5k7g_8ve5ql",
                  "blocks": [
                    {
                      "id": "b_mt3a5k7g_qki7y5",
                      "type": "heading",
                      "level": 2,
                      "text": "Five habits to carry forward"
                    },
                    {
                      "id": "b_mt3a5k7g_u18zcz",
                      "type": "image",
